# Production environment variables for docker-compose
# Copy to .env and fill in real values before deploying

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL password (used by postgres service + backend DATABASE_URL)
POSTGRES_PASSWORD=change-me-strong-password

# ── Domain & TLS ──────────────────────────────────────────────────────────────
# Public domain name — used by nginx and baked into the Next.js bundle.
# Rebuild images after changing: make docker-build DOMAIN=yourdomain.com
DOMAIN=yourdomain.com

# Email for Let's Encrypt certificate registration
CERTBOT_EMAIL=admin@yourdomain.com
