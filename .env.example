# Production environment variables for docker-compose
# Copy to .env and fill in real values before deploying

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL password (used by postgres service + backend DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_RANDOM_PASSWORD

# Backend/admin secrets shared by docker-compose services.
# Keep ADMIN_API_KEY identical to backend/.env.
ADMIN_API_KEY=CHANGE_THIS_TO_MATCH_BACKEND_ADMIN_API_KEY

# Frontend server-side admin login/session secrets.
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_ADMIN_PASSWORD
ADMIN_SESSION_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_SESSION_TOKEN
CUSTOMER_SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_CUSTOMER_SESSION_SECRET

# ── Domain & TLS ──────────────────────────────────────────────────────────────
# Public domain name — used by nginx and baked into the Next.js bundle.
# Rebuild images after changing: make docker-build DOMAIN=yourdomain.com
DOMAIN=yourdomain.com

# Email for Let's Encrypt certificate registration
CERTBOT_EMAIL=admin@yourdomain.com

# ── Grafana ───────────────────────────────────────────────────────────────────
# Grafana admin credentials (dashboard at localhost:3001 via SSH tunnel)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana-password

# Optional push notifications. Leave empty if disabled.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
