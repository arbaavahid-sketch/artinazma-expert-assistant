# ==========================================
# ArtinAzma Expert Assistant — .gitignore
# ==========================================

# --------------------
# Backend / Python
# --------------------
backend/venv/
backend/__pycache__/
backend/*.pyc
__pycache__/
**/__pycache__/
*.pyc
backend/.env
backend/.env.*

# Runtime data & uploads (not source code)
backend/uploads/
backend/storage/
backend/knowledge_files/
backend/google_drive_files/
storage/
backups/
backup_data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sql.gz
*.dump
*.bak
*.snapshot

# Service account credentials
backend/google-service-account.json
*.service-account.json
*.service_account.json
*service-account*.json
*service_account*.json
credentials*.json
*credentials*.json
client_secret*.json
*client_secret*.json
google-service-account.json

# Qdrant local data
backend/qdrant_data/

# --------------------
# Frontend / Next.js
# --------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/test-results/
frontend/playwright-report/
frontend/.env.local
frontend/.env
frontend/.env.*
frontend/.vercel/
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# --------------------
# General env files
# --------------------
.env
.env.*
*.env
.env.local
.env.production
.env.*.local

# Exception: example/template files SHOULD be committed
!.env.example
!.env.local.example
!**/.env.example
!**/.env.local.example

# --------------------
# Logs
# --------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# --------------------
# System & Editor
# --------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --------------------
# Certificates / Secrets
# --------------------
*.pem
*.key
*.p12
*.pfx

# --------------------
# Android signing (NEVER commit — losing the keystore means you can never
# update the published app again)
# --------------------
*.jks
*.keystore
frontend/android/app/keystore.properties
frontend/android/app/*.jks
frontend/android/app/google-services.json

# --------------------
# Temp / Debug files (already tracked — use git rm --cached to untrack)
# --------------------
node_modules/
frontend/answer.txt
frontend/tsconfig.tsbuildinfo

# Sitemap XMLs belong on the web server, not in source code
backend/*.xml

# Generated eval reports
docs/evals/latest_eval_report.json
docs/evals/latest_eval_report.md

# Exception: self-signed dev certs committed so docker compose works out of the box.
# Production certs (issued by certbot) stay on the server and are NEVER committed.
!nginx/certs/fullchain.pem
!nginx/certs/privkey.pem


# TLS certificates / private keys (generate at deploy, never commit)
nginx/certs/*.pem
nginx/certs/*.key
nginx/certs/*.crt
outputs/.~lock.artinazma-expert-assistant-v3-new.pdf#
outputs/.~lock.artinazma-expert-assistant-v3.pdf#
