# ==========================================
# ArtinAzma Expert Assistant — .gitignore
# ==========================================

# --------------------
# Backend / Python
# --------------------
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/.env
backend/.env.*

# Runtime data & uploads (not source code)
backend/uploads/
backend/storage/
backend/knowledge_files/
backend/google_drive_files/

# Service account credentials
backend/google-service-account.json
*.service-account.json

# Qdrant local data
backend/qdrant_data/

# --------------------
# Frontend / Next.js
# --------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env.local
frontend/.env
frontend/.env.*
frontend/.vercel/
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# --------------------
# General env files
# --------------------
.env
.env.*
*.env
.env.local
.env.production
.env.*.local

# Exception: example/template files SHOULD be committed
!.env.example
!.env.local.example
!**/.env.example
!**/.env.local.example

# --------------------
# Logs
# --------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# --------------------
# System & Editor
# --------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --------------------
# Certificates / Secrets
# --------------------
*.pem
*.key
*.p12
*.pfx

# --------------------
# Temp / Debug files (already tracked — use git rm --cached to untrack)
# --------------------
node_modules/
frontend/answer.txt
frontend/tsconfig.tsbuildinfo

# Sitemap XMLs belong on the web server, not in source code
backend/*.xml

# Exception: self-signed dev certs committed so docker compose works out of the box.
# Production certs (issued by certbot) stay on the server and are NEVER committed.
!nginx/certs/fullchain.pem
!nginx/certs/privkey.pem
