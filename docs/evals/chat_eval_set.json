{
  "name": "artinazma-chat-eval-set",
  "version": 1,
  "description": "Evaluation questions for ArtinAzma Expert Assistant covering Persian/English industrial, lab, equipment, troubleshooting, standards, commercial, and follow-up scenarios.",
  "cases": [
    {
      "id": "fa-standard-astm-d4294",
      "language": "fa",
      "domain": "petroleum",
      "message": "ASTM D4294 دقیقا برای چه چیزی استفاده می‌شود و چه نکات اجرایی مهمی دارد؟",
      "expected_intent": "standard_explanation",
      "expected_search_behavior": "gpt_astm_direct_or_web",
      "should_use_web": true,
      "must_include": ["EDXRF", "گوگرد", "نفت", "کالیبراسیون", "اثر ماتریس"],
      "must_not_include": ["ASTM D2622 را به جای D4294 توضیح ندهد", "عدد قطعی LOD بدون منبع نسازد"],
      "quality_checks": ["standard-specific", "practical-lab-guidance", "no-standard-text-copy"]
    },
    {
      "id": "fa-standard-astm-d2622",
      "language": "fa",
      "domain": "petroleum",
      "message": "تفاوت ASTM D2622 و D4294 برای اندازه‌گیری گوگرد در فرآورده نفتی چیست؟",
      "expected_intent": "method_comparison",
      "expected_search_behavior": "local_or_web",
      "should_use_web": true,
      "must_include": ["جدول مقایسه", "WDXRF", "EDXRF", "ماتریس نمونه", "انتخاب روش"],
