# ==========================================
# ArtinAzma Frontend — Environment Variables
# Copy this file to .env.local and fill in values
# ==========================================

# Backend API URL (visible to browser — do NOT put secrets here)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# WebSocket URL for real-time chat (ws:// for dev, wss:// for production)
NEXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8000

# --- Server-side secrets (NOT exposed to browser) ---

# Must match ADMIN_API_KEY in backend/.env
ADMIN_API_KEY=change-me-use-a-strong-random-string

# Admin login password (for the /admin-login page)
# Use a strong password
ADMIN_PASSWORD=change-me-strong-admin-password

# Random session token (e.g.: openssl rand -hex 32)
ADMIN_SESSION_TOKEN=change-me-random-session-token

# --- Push Notifications ---
# VAPID public key (must match backend's VAPID_PRIVATE_KEY pair)
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
