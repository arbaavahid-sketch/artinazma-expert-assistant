# ==========================================
# ArtinAzma Backend — Environment Variables
# Copy this file to .env and fill in values
# ==========================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-5.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=120
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for custom endpoints
# OPENAI_PROXY=socks5://user:pass@host:port   # optional proxy for restricted regions

# --- Admin ---
# Use a strong random string, e.g.: openssl rand -hex 32
ADMIN_API_KEY=change-me-use-a-strong-random-string

# --- CORS (comma-separated allowed origins) ---
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Google Drive (optional) ---
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-folder-id
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=google-service-account.json

# --- Qdrant Vector DB (optional — leave empty to use local JSON store) ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Telegram notifications (optional — leave empty to disable) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- JWT Authentication ---
# Use a strong random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-use-a-strong-random-string
JWT_EXPIRE_HOURS=72
# Send auth cookies only over HTTPS. Defaults to secure when ENVIRONMENT=production.
# Set to false only for local HTTP development.
COOKIE_SECURE=

# --- Sentry Error Tracking (optional — leave empty to disable) ---
SENTRY_DSN=
ENVIRONMENT=production

# --- Push Notifications (optional — leave empty to disable) ---
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=your-email@example.com

# --- CSRF Protection ---
# Random secret for CSRF token generation (auto-generated if not set)
# Use: python -c "import secrets; print(secrets.token_hex(32))"
CSRF_SECRET=
